generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CurriculumClass {
  id         String @id @default(cuid())
  classLevel Int @unique
  sections   CurriculumSection[]
}

model CurriculumSection {
  id              String @id
  name            String
  classLevel      Int
  curriculumClass CurriculumClass @relation(fields: [classLevel], references: [classLevel])
  chapters        Chapter[]
  exercises       Exercise[]
}

model Chapter {
  id           String @id @default(cuid())
  sectionId    String
  number       Int
  title        String
  titleTamil   String
  englishPages String?
  tamilPages   String?
  topics       Json?
  section      CurriculumSection @relation(fields: [sectionId], references: [id])
  exercises    Exercise[]
  @@unique([sectionId, number])
}

model Exercise {
  id             String @id
  sectionId      String
  chapterNumber  Int
  exerciseNumber String
  language       String @default("en")
  topicId        String?
  lessonSlug     String?
  practiceSetId  String?
  pageEnglish    Int?
  pageTamil      Int?
  questionEnglish String?
  questionTamil   String?
  solutionEnglish String?
  solutionTamil   String?
  contentStatus   String @default("PENDING_CONTENT")
  status         String @default("UNMAPPED")
  section        CurriculumSection @relation(fields: [sectionId], references: [id])
  chapter        Chapter @relation(fields: [sectionId, chapterNumber], references: [sectionId, number])
  progress       ExerciseProgress[]
  @@unique([sectionId, chapterNumber, exerciseNumber, language])
}

model Learner {
  id        String             @id @default(cuid())
  user      User?              @relation(fields: [userId], references: [id])
  userId    String?            @unique
  name      String?
  createdAt DateTime           @default(now())
  progress  ExerciseProgress[]
  academicRecords AcademicRecord[]
}

model ExerciseProgress {
  id          String    @id @default(cuid())
  learnerId   String
  exerciseId  String
  answer      String?
  status      String    @default("STARTED")
  completedAt DateTime?
  learner     Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  @@unique([learnerId, exerciseId])
}


model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String?
  googleSubject  String?  @unique
  role           String   @default("LEARNER")
  createdAt      DateTime @default(now())
  learner        Learner?
}

model AcademicRecord {
  id           String   @id @default(cuid())
  learnerId    String
  school       String
  classLevel   Int
  rollNumber   String
  academicYear String
  status       String   @default("PENDING")
  requestedAt  DateTime @default(now())
  reviewedAt   DateTime?
  learner      Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  @@unique([learnerId, academicYear])
}
